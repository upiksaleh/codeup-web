{
  "name": "codeup-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fix:format": "oxfmt --write .",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "check:lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm check:format && pnpm check:lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "mermaid": "12.2.0",
    "next": "16.4.3",
    "notion-client": "8.0.8",
    "notion-types": "8.0.8",
    "notion-utils": "8.0.8",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-notion-x": "8.0.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/prismjs": "1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
